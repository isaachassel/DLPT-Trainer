      "type": "array"
    },
    "reading_ability": {
      "$ref": "#/$defs/AbilityEstimate"
    },
    "listening_ability": {
      "$ref": "#/$defs/AbilityEstimate"
    },
    "topic_exposure": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Topic Exposure",
      "type": "object"
    },
    "genre_exposure": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Genre Exposure",
      "type": "object"
    },
    "question_type_exposure": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Question Type Exposure",
      "type": "object"
    },
    "item_exposure": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Item Exposure",
      "type": "object"
