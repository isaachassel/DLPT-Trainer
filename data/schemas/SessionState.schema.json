    "current_answer_changes": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Current Answer Changes",
      "type": "object"
    },
    "current_listening_plays": {
      "default": 0,
      "title": "Current Listening Plays",
      "type": "integer"
    },
    "completed_passage_ids": {
      "items": {
        "type": "string"
      },
      "title": "Completed Passage Ids",
      "type": "array"
    },
    "completed_question_ids": {
      "items": {
        "type": "string"
      },
      "title": "Completed Question Ids",
      "type": "array"
    },
    "responses": {
