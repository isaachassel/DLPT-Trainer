      "title": "Feedback Mode",
      "type": "string"
    },
    "hints_enabled": {
      "default": false,
      "title": "Hints Enabled",
      "type": "boolean"
    },
    "transcript_review_enabled": {
      "default": false,
      "title": "Transcript Review Enabled",
      "type": "boolean"
    },
    "replay_allowed": {
      "default": false,
      "title": "Replay Allowed",
      "type": "boolean"
    },
    "slow_audio_allowed": {
      "default": false,
      "title": "Slow Audio Allowed",
      "type": "boolean"
    },
    "voice_label": {
      "default": "Russian Female — Svetlana",
