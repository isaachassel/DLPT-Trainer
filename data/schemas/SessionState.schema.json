        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Content Source"
    },
    "last_content_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Content Note"
    },
    "request_nonce": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
