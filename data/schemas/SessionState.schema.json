{
  "$defs": {
    "AbilityEstimate": {
      "additionalProperties": false,
      "properties": {
        "skill": {
          "enum": [
            "reading",
            "listening"
          ],
          "title": "Skill",
          "type": "string"
        },
        "theta": {
          "default": 0.0,
          "title": "Theta",
          "type": "number"
        },
        "standard_error": {
          "default": 1.25,
          "title": "Standard Error",
          "type": "number"
        },
        "ci_low": {
          "default": -2.5,
          "title": "Ci Low",
          "type": "number"
        },
        "ci_high": {
          "default": 2.5,
          "title": "Ci High",
          "type": "number"
        },
        "posterior_grid": {
          "items": {
            "type": "number"
          },
          "title": "Posterior Grid",
          "type": "array"
        },
        "posterior_weights": {
          "items": {
            "type": "number"
          },
          "title": "Posterior Weights",
          "type": "array"
        },
        "items_answered": {
          "default": 0,
          "title": "Items Answered",
          "type": "integer"
        },
        "correct": {
          "default": 0,
          "title": "Correct",
          "type": "integer"
        },
        "practice_ilr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Practice Ilr"
        },
        "confidence": {
          "default": "insufficient",
          "enum": [
            "insufficient",
            "low",
            "moderate",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "provisional": {
          "default": true,
          "title": "Provisional",
          "type": "boolean"
        },
        "stable": {
          "default": false,
          "title": "Stable",
          "type": "boolean"
        },
        "predicted_success": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Predicted Success",
          "type": "object"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "skill"
      ],
      "title": "AbilityEstimate",
      "type": "object"
    },
    "ResponseRecord": {
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "passage_id": {
          "title": "Passage Id",
          "type": "string"
        },
        "question_id": {
          "title": "Question Id",
          "type": "string"
        },
        "skill": {
          "enum": [
            "reading",
            "listening"
          ],
          "title": "Skill",
          "type": "string"
        },
        "mode": {
          "enum": [
            "training",
            "diagnostic",
            "simulation"
          ],
          "title": "Mode",
          "type": "string"
        },
        "target_ilr": {
          "title": "Target Ilr",
          "type": "string"
        },
        "item_difficulty": {
          "title": "Item Difficulty",
          "type": "number"
        },
        "question_type": {
          "title": "Question Type",
          "type": "string"
        },
        "topic": {
          "title": "Topic",
          "type": "string"
        },
        "genre": {
          "title": "Genre",
          "type": "string"
        },
        "stem_en": {
          "title": "Stem En",
          "type": "string"
        },
        "choices_snapshot": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Choices Snapshot",
          "type": "object"
        },
        "rationale_en": {
          "title": "Rationale En",
          "type": "string"
        },
        "evidence_ru": {
          "title": "Evidence Ru",
          "type": "string"
        },
        "selected_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Selected Key"
        },
        "correct_key": {
          "title": "Correct Key",
          "type": "string"
        },
        "is_correct": {
          "title": "Is Correct",
          "type": "boolean"
        },
        "response_time_seconds": {
          "title": "Response Time Seconds",
          "type": "number"
        },
        "listening_play_count": {
          "default": 0,
          "title": "Listening Play Count",
          "type": "integer"
        },
        "answer_change_count": {
          "default": 0,
          "title": "Answer Change Count",
          "type": "integer"
        },
        "provisional_item": {
          "default": true,
          "title": "Provisional Item",
          "type": "boolean"
        },
        "submitted_at": {
          "format": "date-time",
          "title": "Submitted At",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "passage_id",
        "question_id",
        "skill",
        "mode",
        "target_ilr",
        "item_difficulty",
        "question_type",
        "topic",
        "genre",
        "stem_en",
        "choices_snapshot",
        "rationale_en",
        "evidence_ru",
        "selected_key",
        "correct_key",
        "is_correct",
        "response_time_seconds"
      ],
      "title": "ResponseRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "profile_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
