    "generation_requests": {
      "default": 0,
      "title": "Generation Requests",
      "type": "integer"
    },
    "generation_api_calls": {
      "default": 0,
      "title": "Generation Api Calls",
      "type": "integer"
    },
    "generation_repair_count": {
      "default": 0,
      "title": "Generation Repair Count",
      "type": "integer"
    },
    "generated_passage_ids": {
      "items": {
        "type": "string"
      },
      "title": "Generated Passage Ids",
      "type": "array"
    },
    "generation_failures": {
      "default": 0,
      "title": "Generation Failures",
      "type": "integer"
    },
    "bank_fallback_count": {
      "default": 0,
      "title": "Bank Fallback Count",
      "type": "integer"
    },
    "last_content_source": {
      "anyOf": [
        {
          "enum": [
            "starter_bank",
            "generated_bank",
            "fresh_ai"
