# -----------------------------------------------------------------------------
# Russian & Mandarin Adaptive Proficiency Practice — example configuration
# Copy this file to .env for local use. In Hugging Face Spaces, add secret values
# through Settings > Variables and secrets. Never commit real tokens or API keys.
# -----------------------------------------------------------------------------

# Core application
APP_ENV=production
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
QUEUE_CONCURRENCY_LIMIT=4
LOG_LEVEL=INFO

# Item banks and storage
ITEM_BANK_PATH=data/starter_items.jsonl
MANDARIN_ITEM_BANK_PATH=data/mandarin_starter_items.jsonl
GENERATED_ITEM_BANK_PATH=storage/item_bank/generated_items.jsonl
# Leave blank to let a Hugging Face Space automatically choose hybrid Dataset
# persistence when a bank token is available. Explicit choices: local | hf_dataset | hybrid.
STORAGE_BACKEND=
STORAGE_DIR=storage
SESSION_DIR=storage/sessions
HISTORY_DIR=storage/history
AUDIO_CACHE_DIR=storage/cache/audio
QUARANTINE_DIR=storage/quarantine
# Set /data when a Hugging Face persistent volume is mounted.
PERSISTENT_STORAGE_PATH=
# Automatic durable bank: on Spaces, derive a private Dataset repo from SPACE_ID/SPACE_HOST.
AUTO_PROVISION_DATASET_BANK=true
AUTO_DATASET_REPO_SUFFIX=dlpt-generated-bank
# Optional explicit durable generated-bank mirror. When blank, automatic provisioning is used.
HF_DATASET_REPO=
HF_DATASET_PRIVATE=true
HF_DATASET_BANK_FILENAME=generated_items.jsonl
HF_DATASET_MANIFEST_FILENAME=generated_items.meta.json
SYNC_GENERATED_BANK_ON_STARTUP=true
SYNC_GENERATED_BANK_ON_WRITE=true
BANK_SYNC_MAX_RETRIES=3
GENERATED_BANK_MANIFEST_PATH=storage/item_bank/generated_items.meta.json
ENABLE_HISTORY=true
ENABLE_ANALYTICS=false
CHECKPOINT_AFTER_PASSAGE=true

# Hybrid user-requested generation
# With no matching key, Fresh AI automatically falls back to the validated bank.
ENABLE_USER_GENERATION=true
GENERATION_PROVIDER=hf_then_groq
# Backward compatibility: the original GENAI_PROVIDER name is still accepted when
# GENERATION_PROVIDER is absent.
# GENAI_PROVIDER=hf_then_groq
# Choices: disabled | huggingface | groq | hf_then_groq | groq_then_hf | mock
VERIFICATION_PROVIDER=auto
# auto reverses the author-provider order when possible, so a separately configured
# provider/model performs passage audits and blind answer verification.
MAX_GENERATION_REQUESTS_PER_SESSION=8
GENERATION_CONCURRENCY_LIMIT=1
PROVIDER_TIMEOUT_SECONDS=45
PROVIDER_MAX_RETRIES=2
MAX_PROVIDER_ATTEMPTS_PER_STAGE=8

# Provider secrets — put real values only in local .env or Hugging Face Space secrets.
# HF_BANK_TOKEN is recommended for Dataset write access. When absent, HF_TOKEN is used.
HF_TOKEN=
HF_BANK_TOKEN=
GROQ_API_KEY=

# Provider routing and models
HF_PROVIDER=auto
HF_TEXT_MODEL=openai/gpt-oss-120b
HF_VERIFIER_MODEL=openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VERIFIER_MODEL=openai/gpt-oss-20b
# auto tries strict JSON Schema across configured providers, then best-effort schema, JSON-object mode, and a controlled plain-JSON fallback.
# Choices: auto | strict | best_effort | json_object
STRUCTURED_OUTPUT_MODE=auto
ALLOW_PLAIN_JSON_FALLBACK=true
GENERATION_DIAGNOSTICS=true

# Controlled authoring, audit, blind verification, and repair
GENERATION_AUDIT_MODE=always
GENERATION_REPAIR_ATTEMPTS=2
SECOND_VERIFIER_HIGH_RISK=true
AUTHORING_TEMPERATURE=0.25
VERIFICATION_TEMPERATURE=0.0
PASSAGE_MAX_TOKENS=3200
QUESTION_MAX_TOKENS=2600
REPAIR_MAX_TOKENS=3200
AUDIT_MAX_TOKENS=1200
VERIFIER_MAX_TOKENS=2400

# Synthetic TTS and audio lifecycle
EDGE_TTS_VOICE=ru-RU-SvetlanaNeural
MANDARIN_EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
EDGE_TTS_RATE=+0%
AUDIO_CACHE_MAX_AGE_DAYS=30
ORPHAN_TEMP_MAX_AGE_HOURS=12

# Runtime rendering. The app also enforces ssr_mode=False in app.py.
GRADIO_SSR_MODE=false
TTS_TIMEOUT_SECONDS=60
# Optional LOCAL workshop CLI only. Web users enter their own session key.
# Never commit .env or a populated copy of this file.
ELEVENLABS_API_KEY=
